# WalletConnect Project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# zkp2p API Key (for deposit creation)
NEXT_PUBLIC_ZKP2P_API_KEY=your_api_key_here

# Aztec RPC URL (devnet: https://next.devnet.aztec-labs.com)
NEXT_PUBLIC_AZTEC_RPC_URL=https://next.devnet.aztec-labs.com

# Base network: mainnet | sepolia
NEXT_PUBLIC_BASE_NETWORK=mainnet

# Base RPC URL override (defaults from NEXT_PUBLIC_BASE_NETWORK)
NEXT_PUBLIC_BASE_RPC_URL=

# =============================================================================
# Substance Bridge Token Addresses
# Gateway addresses come from SDK constants - only tokens need to be configured
# =============================================================================

# Aztec USDC Token Address (deployed on Aztec devnet)
NEXT_PUBLIC_AZTEC_TOKEN_ADDRESS=

# Base USDC Token Address override
# Mainnet default:  0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Sepolia default:  0x036CbD53842c5426634e7929541eC2318f3dCF7e
NEXT_PUBLIC_BASE_TOKEN_ADDRESS=

# Optional addresses used by the current bridge flow
NEXT_PUBLIC_SOLVER_AZTEC_ADDRESS=
NEXT_PUBLIC_AZTEC_SENDER_ADDRESSES=

# UI shortcut for local testing: when true, stop after funding the burner
NEXT_PUBLIC_BRIDGE_ONLY_MODE=true

# =============================================================================
# Coinbase Paymaster (for gasless burner transactions on Base mainnet)
# =============================================================================

# Get your API key from https://portal.cdp.coinbase.com/
# Navigate to: Paymaster -> Copy endpoint URL
# Format: https://api.developer.coinbase.com/rpc/v1/base/<API_KEY>
NEXT_PUBLIC_COINBASE_PAYMASTER_RPC_URL=

# =============================================================================
# Local-only mock solver keys
# WARNING: NEXT_PUBLIC_* values are shipped to the browser bundle.
# Never use real production keys here or deploy with these values populated.
# =============================================================================
NEXT_PUBLIC_SOLVER_BASE_PRIVATE_KEY=
NEXT_PUBLIC_SOLVER_AZTEC_SECRET_KEY=
NEXT_PUBLIC_SOLVER_AZTEC_SIGNING_KEY=
NEXT_PUBLIC_SOLVER_AZTEC_SALT=
